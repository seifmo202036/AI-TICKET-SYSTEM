NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://username:password@localhost:5432/database_name

JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRES_IN_MINUTES=15

REFRESH_TOKEN_EXPIRES_IN_DAYS=7

CLIENT_ORIGIN=http://localhost:5173

# Direct API access trusts no proxy. Docker Compose sets one trusted nginx hop;
# override TRUST_PROXY_HOPS only when your deployment has a different topology.

BCRYPT_SALT_ROUNDS=12

# Optional private S3-compatible storage for ticket-message images. Leave all
# values unset to disable image uploads. Omit access keys when using an IAM role.
# S3_REGION=us-east-1
# S3_BUCKET_NAME=your-private-ticket-images-bucket
# S3_ENDPOINT=https://your-s3-compatible-endpoint.example.com
# S3_ACCESS_KEY_ID=replace_with_an_access_key
# S3_SECRET_ACCESS_KEY=replace_with_a_secret_key
# S3_SIGNED_URL_EXPIRES_IN_SECONDS=300

# Optional AI ticket triage through Groq's OpenAI-compatible API. Leave the
# provider, API key, and model blank to disable it.
# AI_PROVIDER=openai
# AI_API_KEY=replace_with_your_groq_api_key
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=15000

# Used only when AI triage is enabled.
REDIS_URL=redis://localhost:6379
AI_TRIAGE_CONCURRENCY=3
