NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://username:password@localhost:5432/database_name

JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRES_IN_MINUTES=15

REFRESH_TOKEN_EXPIRES_IN_DAYS=7

CLIENT_ORIGIN=http://localhost:5173

BCRYPT_SALT_ROUNDS=12

# Private S3-compatible storage for ticket-message images.
# Leave access-key values unset when your deployment uses an IAM role.
S3_REGION=us-east-1
S3_BUCKET_NAME=your-private-ticket-images-bucket
# S3_ENDPOINT=https://your-s3-compatible-endpoint.example.com
# S3_ACCESS_KEY_ID=replace_with_an_access_key
# S3_SECRET_ACCESS_KEY=replace_with_a_secret_key
S3_SIGNED_URL_EXPIRES_IN_SECONDS=300
