    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "oxlint src scripts e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:auth": "node scripts/auth-smoke-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "migrate": "node scripts/migrate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seifmo202036/ai-ticket-system.git"
  },
